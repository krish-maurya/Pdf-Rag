# ==============================================================================
# PDF-RAG Environment Variables
# Copy this file to .env in local development or set in deployment platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER (Provide at least one: Google Gemini or OpenAI)
# ------------------------------------------------------------------------------
# Google Gemini API Key (from https://aistudio.google.com/)
GOOGLE_API_KEY=
# or legacy name:
# GOOGLE_GEMINI_KEY=

# Optional OpenAI API Key (if you prefer OpenAI instead of Gemini)
# OPENAI_API_KEY=

# LLM model name (defaults to gemini-2.5-flash for Gemini or gpt-4o-mini for OpenAI)
# LLM_MODEL=gemini-2.5-flash

# Embedding model name (defaults to gemini-embedding-001 or text-embedding-3-small)
# EMBEDDING_MODEL=gemini-embedding-001

# ------------------------------------------------------------------------------
# 2. INFRASTRUCTURE (Redis & Qdrant)
# ------------------------------------------------------------------------------
# Redis connection URL (local docker default: redis://localhost:6379)
REDIS_URL=redis://localhost:6379
# Or separate host/port:
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Qdrant Vector DB URL (local docker default: http://localhost:6333)
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY= (optional for Qdrant Cloud)

# ------------------------------------------------------------------------------
# 3. PDF STORAGE (Cloudinary is optional; falls back to local disk storage in ./uploads)
# ------------------------------------------------------------------------------
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ------------------------------------------------------------------------------
# 4. AUTHENTICATION (Clerk is optional; app runs in open dev mode without it)
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# ------------------------------------------------------------------------------
# 5. SERVER & FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
PORT=8000
RUN_WORKER=true
NEXT_PUBLIC_API_URL=http://localhost:8000
